{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["jest", "@testing-library/jest-dom", "node"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@worker-mock-server/*": ["worker-mock-server/*"],
      "@images/*": ["assets/images/*"],
      "@store/*": ["src/store/*"],
      "@api/*": ["src/api/*"],
      "@__mocks__/*": ["__mocks__/*"],
    }
  },
  "include": ["src", "worker-mock-server"]
}
